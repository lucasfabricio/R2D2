@page "/forms"
@inject ApiService ApiService
@inject NavigationManager Navigation

<div style="max-width: 1200px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fs-3 fw-bold mb-1">📝 Formulários</h1>
            <p class="text-muted mb-0">Gerencie os formulários do sistema</p>
        </div>
        <button class="btn btn-primary" @onclick="OpenCreateModal">
            ➕ Novo Formulário
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5 text-muted">Carregando...</div>
    }
    else if (!forms.Any())
    {
        <div class="v-empty-state">
            <div class="v-empty-icon">📝</div>
            <h3>Nenhum formulário cadastrado</h3>
            <p>Crie seu primeiro formulário para começar</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var form in forms)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold mb-0">@form.Name</h5>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-primary btn-sm" @onclick="() => OpenDesigner(form)">🎨 Designer</button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => ViewForm(form)">👁</button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => OpenEditModal(form)">✏️</button>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteForm(form)">🗑</button>
                                </div>
                            </div>
                            <p class="text-muted small mb-3">@(form.Description ?? "Sem descrição")</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex gap-2 align-items-center">
                                    <span class="badge @(form.FormType == 1 ? "bg-info bg-opacity-10 text-info" : "bg-success bg-opacity-10 text-success")">@(form.FormType == 1 ? "✏️ Atualização" : "📥 Cadastro")</span>
                                    <span class="badge bg-primary bg-opacity-10 text-primary">@form.Fields.Count campo(s)</span>
                                    @if (!string.IsNullOrEmpty(form.WorkflowName))
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning-emphasis" title="Workflow vinculado">⚡ @form.WorkflowName</span>
                                    }
                                </div>
                                <small class="text-muted">@form.CreatedAt.ToString("dd/MM/yyyy")</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Modal: Create/Edit Form *@
<Modal @ref="formModal" Title="@(editingForm?.Id != Guid.Empty ? "Editar Formulário" : "Novo Formulário")">
    <BodyTemplate>
        <div class="mb-3">
            <label class="form-label">Nome</label>
            <input type="text" class="form-control" @bind="editingForm!.Name" placeholder="Nome do formulário" />
        </div>
        <div class="mb-3">
            <label class="form-label">Descrição</label>
            <textarea class="form-control" rows="3" @bind="editingForm!.Description" placeholder="Descrição opcional"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Tipo do Formulário</label>
            <select class="form-select" @bind="editingForm!.FormType">
                <option value="0">📥 Cadastro</option>
                <option value="1">✏️ Atualização</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Workflow (opcional)</label>
            <select class="form-select" @bind="editingForm!.WorkflowId">
                <option value="">Nenhum</option>
                @foreach (var wf in workflows)
                {
                    <option value="@wf.Id">@wf.Name</option>
                }
            </select>
            <small class="text-muted">Ao submeter o formulário, o workflow será executado para validação.</small>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
        <button class="btn btn-primary" @onclick="SaveForm">💾 Salvar</button>
    </FooterTemplate>
</Modal>

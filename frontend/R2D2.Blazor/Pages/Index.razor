@page "/"
@using R2D2.Blazor.Models

<PageTitle>Dashboard - R2D2 Low-Code</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Bem-vindo ao R2D2</h1>
        <p class="text-muted mb-0">Visão geral do seu ecossistema low-code em tempo real.</p>
    </div>
    <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/lists")'>
        Criar Nova Lista
    </button>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="v-stat-icon v-bg-blue">📊</div>
                <div>
                    <h6 class="text-muted fw-normal mb-1">Listas</h6>
                    <div class="fs-4 fw-bold">12</div>
                    <small class="text-muted">Estruturas ativas</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="v-stat-icon v-bg-green">📝</div>
                <div>
                    <h6 class="text-muted fw-normal mb-1">Formulários</h6>
                    <div class="fs-4 fw-bold">24</div>
                    <small class="text-muted">Modelos publicados</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="v-stat-icon v-bg-purple">🔀</div>
                <div>
                    <h6 class="text-muted fw-normal mb-1">Fluxos</h6>
                    <div class="fs-4 fw-bold">8</div>
                    <small class="text-muted">Processos automatizados</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="v-stat-icon v-bg-orange">⚙️</div>
                <div>
                    <h6 class="text-muted fw-normal mb-1">Regras</h6>
                    <div class="fs-4 fw-bold">42</div>
                    <small class="text-muted">Lógicas operacionais</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="mb-0">Atividades Recentes</h5>
                    <button class="btn btn-link text-decoration-none fw-semibold p-0">Ver tudo</button>
                </div>
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex gap-3">
                        <div class="v-activity-dot mt-1"></div>
                        <div>
                            <p class="mb-1"><strong>Nova Lista:</strong> "Clientes VIP" foi criada por Admin.</p>
                            <small class="text-muted">Há 2 horas</small>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <div class="v-activity-dot v-bg-orange mt-1"></div>
                        <div>
                            <p class="mb-1"><strong>Fluxo Editado:</strong> "Backup Noturno" foi atualizado.</p>
                            <small class="text-muted">Há 5 horas</small>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <div class="v-activity-dot v-bg-red mt-1"></div>
                        <div>
                            <p class="mb-1"><strong>Regra Crítica:</strong> Falha de validação em "Validar CPF".</p>
                            <small class="text-muted">Ontem às 18:30</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100 text-white" style="background: var(--v-primary);">
            <div class="card-body d-flex flex-column justify-content-between position-relative overflow-hidden">
                <div>
                    <h5 class="text-white">R2D2 Pro</h5>
                    <p class="opacity-75 mb-4" style="max-width: 180px;">Sua equipe está usando 85% dos recursos disponíveis no plano atual.</p>
                    <button class="btn btn-light fw-semibold" style="color: var(--v-primary);">Upgrade Platform</button>
                </div>
                <div class="v-promo-graphic">🚀</div>
            </div>
        </div>
    </div>
</div>

@inject NavigationManager Navigation

<style>
    .v-stat-icon {
        width: 56px;
        height: 56px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .v-activity-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #3056D3;
        flex-shrink: 0;
    }

    .v-promo-graphic {
        font-size: 80px;
        opacity: 0.2;
        position: absolute;
        right: -10px;
        bottom: -20px;
        transform: rotate(-15deg);
    }
</style>

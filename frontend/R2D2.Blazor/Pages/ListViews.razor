@page "/list-views"
@inject ApiService ApiService
@inject NavigationManager Navigation

<div style="max-width: 1200px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fs-3 fw-bold mb-1">📋 Visões de Listas</h1>
            <p class="text-muted mb-0">Configure páginas de listagem com grids de dados</p>
        </div>
        <button class="btn btn-primary" @onclick="OpenCreateModal">
            ➕ Nova Visão
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5 text-muted">Carregando...</div>
    }
    else if (!listViews.Any())
    {
        <div class="v-empty-state">
            <div class="v-empty-icon">📋</div>
            <h3>Nenhuma visão de lista cadastrada</h3>
            <p>Crie uma visão para exibir dados de listas em formato de tabela</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var view in listViews)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h5 class="card-title fw-bold mb-0">@(view.DisplayName ?? view.Name)</h5>
                                    @if (!string.IsNullOrEmpty(view.DisplayName))
                                    {
                                        <small class="text-muted">@view.Name</small>
                                    }
                                </div>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-primary btn-sm" @onclick="() => OpenBuilder(view)">🔧 Configurar</button>
                                    <button class="btn btn-success btn-sm" @onclick="() => OpenView(view)">👁 Ver</button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => OpenEditModal(view)">✏️</button>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteView(view)">🗑</button>
                                </div>
                            </div>
                            <p class="text-muted small mb-3">Lista: <strong>@view.ListName</strong></p>
                            <div class="d-flex gap-2 flex-wrap align-items-center">
                                <span class="badge bg-primary bg-opacity-10 text-primary">@view.Columns.Count coluna(s)</span>
                                @if (!string.IsNullOrEmpty(view.CreateFormName))
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success" title="Formulário de criação">📥 @view.CreateFormName</span>
                                }
                                @if (!string.IsNullOrEmpty(view.UpdateFormName))
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info" title="Formulário de edição">✏️ @view.UpdateFormName</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Modal: Create/Edit List View *@
<Modal @ref="viewModal" Title="@(editingView?.Id != Guid.Empty ? "Editar Visão" : "Nova Visão de Lista")">
    <BodyTemplate>
        <div class="mb-3">
            <label class="form-label">Nome Interno</label>
            <input type="text" class="form-control" @bind="editingView!.Name" placeholder="Nome técnico" />
        </div>
        <div class="mb-3">
            <label class="form-label">Nome Amigável</label>
            <input type="text" class="form-control" @bind="editingView!.DisplayName" placeholder="Nome amigável (opcional)" />
        </div>
        <div class="mb-3">
            <label class="form-label">Lista de Dados</label>
            <select class="form-select" @bind="editingView!.ListId">
                <option value="">-- Selecione --</option>
                @foreach (var list in availableLists)
                {
                    <option value="@list.Id">@(list.DisplayName ?? list.Name) (@list.Name)</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Formulário de Criação (opcional)</label>
            <select class="form-select" @bind="editingView!.CreateFormId">
                <option value="">Nenhum</option>
                @foreach (var form in availableForms.Where(f => f.FormType == 0))
                {
                    <option value="@form.Id">@form.Name</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Formulário de Atualização (opcional)</label>
            <select class="form-select" @bind="editingView!.UpdateFormId">
                <option value="">Nenhum</option>
                @foreach (var form in availableForms.Where(f => f.FormType == 1))
                {
                    <option value="@form.Id">@form.Name</option>
                }
            </select>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
        <button class="btn btn-primary" @onclick="SaveView">💾 Salvar</button>
    </FooterTemplate>
</Modal>

@code {
    private List<ListView> listViews = new();
    private List<DynamicList> availableLists = new();
    private List<DynamicForm> availableForms = new();
    private bool isLoading = true;

    private Modal viewModal = default!;
    private ListView? editingView;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        listViews = await ApiService.GetListViewsAsync();
        availableLists = await ApiService.GetListsAsync();
        availableForms = await ApiService.GetFormsAsync();
        isLoading = false;
    }

    private async Task OpenCreateModal()
    {
        editingView = new ListView();
        await viewModal.ShowAsync();
    }

    private async Task OpenEditModal(ListView view)
    {
        editingView = new ListView
        {
            Id = view.Id,
            Name = view.Name,
            DisplayName = view.DisplayName,
            ListId = view.ListId,
            CreateFormId = view.CreateFormId,
            UpdateFormId = view.UpdateFormId
        };
        await viewModal.ShowAsync();
    }

    private async Task CloseModal() => await viewModal.HideAsync();

    private async Task SaveView()
    {
        if (editingView == null || string.IsNullOrWhiteSpace(editingView.Name)) return;

        if (editingView.Id == Guid.Empty)
        {
            var created = await ApiService.CreateListViewAsync(editingView);
            if (created != null) listViews.Add(created);
        }
        else
        {
            await ApiService.UpdateListViewAsync(editingView.Id, editingView);
        }

        await CloseModal();
        await LoadData();
    }

    private async Task DeleteView(ListView view)
    {
        await ApiService.DeleteListViewAsync(view.Id);
        await LoadData();
    }

    private void OpenBuilder(ListView view)
    {
        Navigation.NavigateTo($"/list-view-builder/{view.Id}");
    }

    private void OpenView(ListView view)
    {
        Navigation.NavigateTo($"/view/{view.Id}");
    }
}

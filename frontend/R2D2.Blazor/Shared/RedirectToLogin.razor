@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

@code {
    protected override void OnInitialized()
    {
        // Only redirect if the auth state provider has actually resolved
        // (i.e., JS Interop is ready and we confirmed user is not authenticated).
        // If interop is not ready yet, do nothing — let MarkAsReadyAsync re-evaluate.
        if (AuthStateProvider is Services.CustomAuthenticationStateProvider customProvider 
            && customProvider.IsInteropReady)
        {
            Navigation.NavigateTo("/login");
        }
    }
}
